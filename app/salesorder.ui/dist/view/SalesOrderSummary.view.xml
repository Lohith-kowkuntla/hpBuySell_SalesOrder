
<!-- Screen: Sales Order Summary -->

<mvc:View
    controllerName="hpbuysell.otc.salesorder.ui.controller.SalesOrderSummary"
    xmlns="sap.m"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns:core="sap.ui.core"
    xmlns:f="sap.f"
    height="100%">

    <f:DynamicPage
        id="salesOrderSummaryPage"
        headerExpanded="true"
        toggleHeaderOnTitleClick="true"
        busy="{view>/busy}"
        busyIndicatorDelay="0">

        <!-- ============================================================= -->
        <!-- TITLE                                                         -->
        <!-- ============================================================= -->

        <f:title>

            <f:DynamicPageTitle
                id="salesOrderSummaryTitle">

                <f:navigationActions>

                    <Button
                        id="salesOrderSummaryBackButton"
                        type="Transparent"
                        icon="sap-icon://nav-back"
                        tooltip="{i18n>back}"
                        press=".onNavBackPress"/>

                </f:navigationActions>

                <f:heading>

                    <Title
                        id="salesOrderSummaryPageTitle"
                        text="{i18n>salesOrderSummary}"
                        level="H1"/>

                </f:heading>

                <f:expandedContent>

                    <Text
                        id="salesOrderSummarySubtitle"
                        text="{i18n>soSummarySubtitle}"/>

                </f:expandedContent>

            </f:DynamicPageTitle>

        </f:title>

        <!-- ============================================================= -->
        <!-- FILTER SECTION                                                -->
        <!-- ============================================================= -->

        <f:header>

            <f:DynamicPageHeader
                id="salesOrderSummaryPageHeader"
                pinnable="true">

                <HBox
                    id="soSummaryFilterBox"
                    wrap="Wrap"
                    alignItems="End">

                    <VBox
                        id="soSummaryBusinessModelBox"
                        class="sapUiSmallMarginEnd">

                        <Label
                            id="soSummaryBusinessModelLabel"
                            text="{i18n>businessModel}"/>

                        <ComboBox
                            id="soSummaryBusinessModelCombo"
                            selectedKey="{view>/businessModel}"
                            width="14rem"
                            placeholder="{i18n>allValues}"
                            selectionChange=".onDimensionChange"
                            items="{path: '/VH_BusinessModel', sorter: {path: 'businessModel'}}">

                            <core:Item
                                key="{businessModel}"
                                text="{businessModel}"/>

                        </ComboBox>

                    </VBox>

                    <VBox
                        id="soSummaryCustomerCodeBox"
                        class="sapUiSmallMarginEnd">

                        <Label
                            id="soSummaryCustomerCodeLabel"
                            text="{i18n>customerCode}"/>

                        <ComboBox
                            id="soSummaryCustomerCodeCombo"
                            selectedKey="{view>/customerCode}"
                            width="16rem"
                            placeholder="{i18n>allValues}"
                            selectionChange=".onDimensionChange"
                            items="{path: '/VH_Customer', sorter: {path: 'customerCode'}}">

                            <core:Item
                                key="{customerCode}"
                                text="{customerCode}"/>

                        </ComboBox>

                    </VBox>

                    <VBox
                        id="soSummaryCompanyCodeBox"
                        class="sapUiSmallMarginEnd">

                        <Label
                            id="soSummaryCompanyCodeLabel"
                            text="{i18n>hpCompanyCode}"/>

                        <ComboBox
                            id="soSummaryCompanyCodeCombo"
                            selectedKey="{view>/hpCompanyCode}"
                            width="14rem"
                            placeholder="{i18n>allValues}"
                            selectionChange=".onDimensionChange"
                            items="{path: '/VH_CompanyCode', sorter: {path: 'hpCompanyCode'}}">

                            <core:Item
                                key="{hpCompanyCode}"
                                text="{hpCompanyCode} - {hpCompanyDescription}"/>

                        </ComboBox>

                    </VBox>

                    <Button
                        id="soSummaryClearButton"
                        text="{i18n>clear}"
                        press=".onClearDimensions"
                        class="sapUiSmallMarginEnd sapUiTinyMarginBottom"/>

                </HBox>

            </f:DynamicPageHeader>

        </f:header>

        <!-- ============================================================= -->
        <!-- STATUS TILES                                                  -->
        <!-- ============================================================= -->

        <f:content>

            <VBox id="soSummaryContentBox">

                <FlexBox
                    id="soSummaryTileBox"
                    wrap="Wrap"
                    alignItems="Start"
                    class="sapUiSmallMargin"
                    items="{path: 'summary>/counts'}">

                    <GenericTile
                        id="soSummaryTile"
                        class="sapUiTinyMargin"
                        header="{summary>description}"
                        subheader="{i18n>soSummaryTileSubheader}"
                        tooltip="{i18n>soSummaryTilePressTooltip}"
                        press=".onTilePress"
                        state="Loaded">

                        <TileContent
                            id="soSummaryTileContent"
                            unit="{i18n>soSummaryTileSubheader}">

                            <NumericContent
                                id="soSummaryTileNumber"
                                value="{summary>count}"
                                valueColor="{summary>criticality}"
                                withMargin="false"/>

                        </TileContent>

                    </GenericTile>

                </FlexBox>

                <IllustratedMessage
                    id="soSummaryEmptyMessage"
                    visible="{= ${summary>/counts}.length === 0}"
                    illustrationType="sapIllus-NoData"
                    title="{i18n>soSummaryNoData}"/>

            </VBox>

        </f:content>

    </f:DynamicPage>

</mvc:View>
